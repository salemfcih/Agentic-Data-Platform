# Copy to .env and set your own values. .env is ignored by git.

# Root secret for the local Polaris catalog. Choose any value for local use.
POLARIS_ROOT_SECRET=

# Base64 of "<public key>:<secret key>" for the LLM observability backend's OTLP endpoint.
# Leave empty if you are not running that backend locally.
LANGFUSE_OTLP_BASIC_AUTH=
